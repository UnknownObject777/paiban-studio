{
  "name": "paiban-studio",
  "version": "0.1.0",
  "description": "AI 驱动的 Office 排版本地工作台（Word MVP）——对话式 AI 直接修改 docx + 实时预览 + 版本链，本地优先",
  "type": "module",
  "main": "dist/src/main.js",
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "test:roundtrip": "npm run build && node --test dist/test/roundtrip.test.js",
    "test:edits": "npm run build && node --test dist/test/edits.test.js",
    "test:storage": "npm run build && node --test dist/test/storage.test.js",
    "test:templates": "npm run build && node --test dist/test/templates.test.js",
    "test:workspace": "npm run build && node --test dist/test/workspace.test.js",
    "test:e2e-agent": "npm run build && node --test dist/test/e2e-agent.test.js",
    "dist": "npm run build && electron-builder",
    "preview": "npm run build && node dist/preview/serve.js",
    "fetch:onlyoffice": "node scripts/fetch-onlyoffice-sdk.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "fast-xml-parser": "^5.10.1",
    "pizzip": "^3.2.0"
  },
  "build": {
    "appId": "com.paiban.studio",
    "productName": "排版工作台",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**",
      "public/**",
      "templates/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pizzip": "^3.0.5",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  }
}
