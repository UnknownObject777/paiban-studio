{
  "ruleset": "lab-report-default",
  "version": 1,
  "description": "实验报告默认规则集（手写草稿，issue #17 决策评议用）· 识别规则（component id → match 规则）。面向高校实验报告形态：含「实验目的/实验原理/实验步骤/数据记录与处理/误差分析/结论」等无编号固定栏目名",
  "components": {
    "title": {
      "match": [
        {
          "type": "position",
          "where": "documentStart",
          "params": { "maxParagraphs": 5 },
          "notes": "文档开头若干段落内寻找；封面/首行大字通常为报告题目"
        },
        {
          "type": "regex",
          "pattern": "实验(报告|总结)",
          "notes": "含「实验报告」「实验总结」字样的段落（如《XX实验》实验报告）；position 规则优先，本条为文档化补充"
        },
        {
          "type": "heuristic",
          "kind": "consecutiveCenteredUniformFont",
          "notes": "连续居中且字体字号一致的段落判为题目"
        }
      ]
    },
    "subtitle": {
      "match": [
        {
          "type": "position",
          "where": "afterComponent",
          "params": { "component": "title", "within": 2 },
          "notes": "题目下方；实验报告常为课程名 / 姓名学号 / 日期行"
        },
        {
          "type": "heuristic",
          "kind": "centeredDifferentFont",
          "notes": "居中且字体字号与题目不同的段落判为副标题"
        }
      ]
    },
    "heading1": {
      "match": [
        {
          "type": "regex",
          "pattern": "^(?:第[0-9一二三四五六七八九十百]+[章节]|[一二三四五六七八九十]+、|(?:实验目的|实验原理|实验内容|实验步骤|实验过程|实验仪器|实验器材|实验设备|实验数据|数据记录|数据记录与处理|数据处理|实验结果|结果分析|结果与讨论|误差分析|实验结论|结论|讨论|思考题|心得体会|参考文献|附录)\\s*$)",
          "notes": "一级标题两类：①第X章/第X节、一、二、 等编号式（行首前缀匹配）；②实验报告无编号固定栏目名（实验目的/实验原理/实验步骤/数据记录与处理/误差分析/结论等，需独占一行整行匹配，防止误伤正文句首）"
        }
      ]
    },
    "heading2": {
      "match": [
        {
          "type": "regex",
          "pattern": "^(?:（[一二三四五六七八九十]+）|\\d+\\.\\d+)",
          "notes": "（一）（二）或 1.1 2.3 等小节编号；与公文不同，实验报告常用 X.Y 数字小节"
        }
      ]
    },
    "heading3": {
      "match": [
        {
          "type": "regex",
          "pattern": "^\\d+[.．、]",
          "notes": "1. 2. 1． 1、 等；X.Y 形式已被 heading2 先命中"
        }
      ]
    },
    "heading4": {
      "match": [
        {
          "type": "regex",
          "pattern": "^[（(]\\d+[）)]",
          "notes": "（1）(1) 等"
        }
      ]
    },
    "body": {
      "fallback": true,
      "notes": "未被以上规则命中的普通段落一律视为正文"
    },
    "caption": {
      "match": [
        {
          "type": "regex",
          "pattern": "^(图|表)\\s*\\d+",
          "notes": "图1 表2 等起始的段落；实验报告图表较多，与公文一致"
        },
        {
          "type": "heuristic",
          "kind": "centeredAdjacentToFigureOrTable",
          "notes": "位于图片或表格上下相邻位置的居中段落"
        }
      ]
    },
    "table": {
      "match": [
        {
          "type": "heuristic",
          "kind": "isTableElement",
          "notes": "OOXML 表格元素本身，无需文本规则；实验报告数据记录表主要载体"
        }
      ]
    },
    "attachment": {
      "match": [
        {
          "type": "regex",
          "pattern": "^(附件|附录)\\s*[A-Za-z0-9]*\\s*[:：]?",
          "notes": "附件 / 附录A / 附录： 等形式；实验报告常用附录放原始数据或程序代码"
        }
      ]
    }
  }
}
